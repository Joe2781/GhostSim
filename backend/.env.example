# =========================================================
# GhostSim API — Environment Configuration Template
# Copy to .env for local development.
# Never commit a real .env file to GitHub.
# =========================================================

# Application
APP_NAME=GhostSim API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false

# Local API server
HOST=127.0.0.1
PORT=8000

# =========================================================
# PostgreSQL
# Replace CHANGE_ME with the actual database password.
# For production, use the database provider's secure
# connection string and required SSL settings.
# =========================================================

DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=ghostsim
DATABASE_USER=ghostsim_app
DATABASE_PASSWORD=CHANGE_ME
DATABASE_SSL_REQUIRED=true

# Connection pool
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=10

# =========================================================
# Frontend
# Add your actual frontend origin when known.
# Separate multiple origins with commas.
# Do not use "*" with credentialed requests.
# =========================================================

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Maximum accepted request body: 1 MiB by default.
MAX_REQUEST_BODY_BYTES=1048576

# =========================================================
# Optional AI configuration
# Core connectivity must not depend on Gemini availability.
# Keep AI routing disabled until its service is implemented.
# =========================================================

AI_ROUTING_ENABLED=false

# Configure these only when the integration is implemented.
# GEMINI_API_KEY=
# GEMINI_MODEL=

# =========================================================
# Payment integration
# Configure the real secret only when implementing
# server-side Flutterwave verification and webhooks.
# =========================================================

# FLUTTERWAVE_SECRET_KEY=

# Health diagnostics
EXPOSE_DETAILED_HEALTH=false
